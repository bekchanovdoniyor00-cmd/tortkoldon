# ==========================================
# TO‘RTKO‘LDONMAXSULOTI ERP - SERVER CONFIG
# ==========================================

# Tarmoq sozlamalari
HOST=0.0.0.0
PORT=5051
FLASK_DEBUG=false

# Xavfsizlik kaliti (kamida 32 ta belgidan iborat tasodifiy satr)
SECRET_KEY=tortkoldon_super_secret_production_key_change_me_2026

# Rejim: 'production' yoki 'development'
ERP_MODE=production

# Agar Nginx, Caddy yoki Cloudflare orqasida ishlasa 'true' qiling
BEHIND_PROXY=true

# Ma'lumotlar bazasi yo'li (agar ko'rsatilmasa loyiha ichidagi tortkuldon.db ishlatiladi)
DATABASE_PATH=tortkuldon.db

# Avtomatik zaxira nusxalari (backup) papkasi
BACKUP_DIR=zaxira_nusxalar
