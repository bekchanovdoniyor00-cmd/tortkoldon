{
  "mode": "production",
  "database_path": "C:\\ERPData\\tortkuldon.db",
  "backup_directory": "D:\\ERPBackups",
  "trusted_hosts": [
    "tortkoldon.uz",
    "www.tortkoldon.uz",
    "127.0.0.1"
  ],
  "https_termination": true,
  "proxy": {
    "enabled": true,
    "trusted_hops": 1,
    "remote_addresses": [
      "127.0.0.1"
    ]
  },
  "session_lifetime_seconds": 28800,
  "drain_timeout_seconds": 45,
  "login_rate_limit": {
    "attempts": 5,
    "window_seconds": 900,
    "ip_attempts": 30,
    "ip_window_seconds": 900
  },
  "waitress": {
    "host": "127.0.0.1",
    "port": 5052,
    "threads": 8
  },
  "service_logging": {
    "path": "C:\\ERPLogs\\app\\erp-service.log",
    "max_bytes": 10485760,
    "backup_count": 10
  }
}
