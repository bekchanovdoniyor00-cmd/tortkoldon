map $request_method $erp_login_limit_key {
    default "";
    POST    $binary_remote_addr;
}

limit_req_zone $erp_login_limit_key zone=erp_login:10m rate=10r/m;

server {
    listen 80;
    server_name tortkoldon.uz www.tortkoldon.uz;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name tortkoldon.uz www.tortkoldon.uz;

    ssl_certificate /etc/letsencrypt/live/tortkoldon.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tortkoldon.uz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /zaxira {
        return 404;
    }

    location = /login {
        limit_req zone=erp_login burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Connection "";
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Connection "";
        proxy_read_timeout 180s;
    }
}
