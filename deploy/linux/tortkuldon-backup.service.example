[Unit]
Description=Verified SQLite backup for ToRtkoERP
After=local-fs.target

[Service]
Type=oneshot
User=tortkuldon
Group=tortkuldon
WorkingDirectory=/opt/tortkuldon/current
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/tortkuldon/venv/bin/python /opt/tortkuldon/current/daily_sqlite_backup.py --config /etc/tortkuldon/backup.json
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
ReadOnlyPaths=/var/lib/tortkuldon/tortkuldon.db
ReadWritePaths=/var/backups/tortkuldon
